# NestJS 백엔드(blog-api) 주소. 로컬은 yarn dev로 띄운 http://localhost:4000,
# 프로덕션은 Render에 배포된 주소. 브라우저가 아니라 서버(BFF)만 쓰므로 NEXT_PUBLIC_ 접두어 없음
API_URL=http://localhost:4000

# blog-api가 글 CRUD 후 /api/revalidate 웹훅을 부를 때 x-revalidate-secret 헤더로 검증하는 값.
# blog-api의 REVALIDATE_SECRET과 반드시 같아야 함
REVALIDATE_SECRET=

# BFF만 아는 공유 시크릿. 방문자 IP를 x-client-ip로 백엔드에 넘길 때 위조 방지용으로 같이 보낸다
# (lib/api.ts의 forwardClientHeaders 참고). blog-api의 INTERNAL_SECRET과 같아야 함
INTERNAL_SECRET=
